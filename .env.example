# Optional canonical origin used only while building SEO metadata.
# Example: https://example.com
SITE_URL=

# Optional deployment subpath, for example /al-amin.
# Keep empty for a custom domain or a host serving out/ from its root.
STATIC_BASE_PATH=

# Candidate applications are downloaded as local .alamin files.
# No cloud inbox, Turnstile, SMTP or Supabase variables are required.
