NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Local: http://localhost:3000. Replace with your HTTPS production domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public brand configuration. It can be changed without touching business logic.
NEXT_PUBLIC_BRAND_NAME=AL-AMIN
NEXT_PUBLIC_BRAND_SHORT_NAME=AL-AMIN
NEXT_PUBLIC_BRAND_TAGLINE=Найдите специалиста, которому можно доверять.
# Only on the server. Never expose this key in the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only transactional email settings. Keep real values out of Git.
EMAIL_PROVIDER=unisender-go
# Unisender Go Web API key. Keep it server-only and out of Git.
UNISENDER_GO_API_KEY=
# Optional; defaults to the official Go API endpoint.
UNISENDER_GO_API_ENDPOINT=https://goapi.unisender.ru/ru/transactional/api/v1/email/send.json
EMAIL_FROM=no-reply@example.com
EMAIL_SENDER_NAME=AL-AMIN
EMAIL_REPLY_TO=no-reply@example.com
EMAIL_SENDER_DOMAIN=example.com
# Unisender Go SMTP values for Supabase Auth custom SMTP (server/dashboard only).
UNISENDER_GO_SMTP_HOST=smtp.go2.unisender.ru
UNISENDER_GO_SMTP_PORT=587
UNISENDER_GO_SMTP_USERNAME=
UNISENDER_GO_TRACKING_DOMAIN=
EMAIL_WORKER_SECRET=
